<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- launchd LaunchAgent for the termulaa terminal server (loopback-only).
     @TERMULAA_BIN@ and @HOME@ are replaced with the absolute binary path
     and the user's home directory by install.sh in service mode;
     substitute them yourself for manual installs. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.termulaa.server</string>
	<key>ProgramArguments</key>
	<array>
		<string>@TERMULAA_BIN@</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>@HOME@/.termulaa/logs/server.log</string>
	<key>StandardErrorPath</key>
	<string>@HOME@/.termulaa/logs/server.log</string>
</dict>
</plist>
